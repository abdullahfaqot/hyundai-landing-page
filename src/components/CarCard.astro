---
interface Props {
  name: string;
  image: string;
  isNew?: boolean;
  pdf?: string;
  slug: string;
  price?: string;
  gradient?: string;
}

const { name, image, isNew, pdf, slug, price } = Astro.props;
const pdfPath = pdf ?? `/brosur/${slug}.pdf`;
---

<div
  class="group relative w-full h-full
         rounded-2xl overflow-hidden
         bg-[#E9DFD3]
         p-4 sm:p-6
         min-h-[300px] sm:min-h-[360px]
         cursor-pointer
         transition-all duration-300
         hover:-translate-y-1 hover:shadow-2xl"
  data-pdf={pdfPath}
>
  <!-- SOFT LIGHT -->
  <div class="absolute inset-0 bg-white/30 opacity-60"></div>

  <!-- BRAND + BADGE -->
  <div class="relative z-30 pointer-events-none">
    <!-- Hidden brand on mobile for cleaner look -->
    <h3
      class="hidden sm:block text-slate-500 font-bold tracking-widest text-sm"
    >
      HYUNDAI
    </h3>

    {
      isNew && (
        <span
          class="relative inline-flex items-center
                 mt-2 px-3 py-1
                 text-[10px] sm:text-xs
                 font-bold tracking-wider
                 text-white bg-red-600
                 rounded-full overflow-hidden
                 shadow-md
                 animate-pulse-soft"
        >
          NEW
          <span
            class="absolute inset-0
                   -translate-x-full
                   bg-gradient-to-r
                   from-transparent via-white/70 to-transparent
                   animate-shine"
          />
        </span>
      )
    }
  </div>

  <!-- IMAGE -->
  <div
    class="absolute bottom-20 sm:bottom-24
           left-0 right-0
           flex justify-center items-end
           h-[180px] sm:h-[220px]
           z-20 pointer-events-none"
  >
    <img
      src={image}
      alt={name}
      class="w-[115%] sm:w-[120%]
             max-w-none object-contain
             transition-transform duration-500
             group-hover:scale-110 group-hover:-translate-y-3
             drop-shadow-[0_25px_35px_rgba(0,0,0,0.3)]"
    />
  </div>

  <!-- HOVER OVERLAY (Desktop only feel) -->
  <div
    class="absolute inset-0 z-20
           flex items-center justify-center
           bg-black/0
           opacity-100 md:opacity-0
           md:group-hover:opacity-100
           md:group-hover:bg-black/25
           transition-all duration-300
           pointer-events-none"
  >
    <div
      class="pointer-events-auto
             w-9 h-9 sm:w-10 sm:h-10
             rounded-full
             flex items-center justify-center
             border border-white/50
             bg-white/10 backdrop-blur-sm
             transition-all duration-300
             hover:border-transparent
             hover:bg-[#E1D6CB]"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 text-white"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </div>
  </div>

  <!-- FADE -->
  <div
    class="absolute bottom-0 left-0 right-0 h-24 sm:h-32
           bg-gradient-to-t from-black/25 to-transparent z-10"
  >
  </div>

  <!-- NAME -->
  <div
    class="absolute bottom-6 left-0 right-0
           text-center text-slate-800
           font-semibold text-base sm:text-lg
           tracking-wide
           transition z-20 pointer-events-none"
  >
    {name}
  </div>

  {
    price && (
      <div
        class="absolute bottom-14 left-0 right-0
               text-center text-slate-600
               font-medium text-xs sm:text-sm
               transition z-20 pointer-events-none"
      >
        {price}
      </div>
    )
  }
</div>

<style>
  @keyframes shine {
    0% {
      transform: translateX(-120%);
    }
    70% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }

  @keyframes pulseSoft {
    0%,
    100% {
      box-shadow: 0 0 0 rgba(220, 38, 38, 0);
    }
    50% {
      box-shadow: 0 0 14px rgba(220, 38, 38, 0.6);
    }
  }

  .animate-shine {
    animation: shine 3s ease-in-out infinite;
  }

  .animate-pulse-soft {
    animation: pulseSoft 1.6s ease-in-out infinite;
  }
</style>
