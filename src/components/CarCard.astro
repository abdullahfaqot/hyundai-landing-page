---
const { name, image, gradient, isNew, slug } = Astro.props;
---

<a
  href={`/tipe-mobil/${slug}`}
  class={`block w-full h-full relative
          group rounded-2xl overflow-hidden
          bg-gradient-to-br ${gradient}
          p-6 min-h-[320px]
          transition-all duration-300
          hover:scale-[1.02]`}
>
  <!-- AMBIENT GLOW -->
  <div class="absolute inset-0 bg-white/10 blur-3xl opacity-30"></div>

  <!-- TEXT -->
  <div class="relative z-10">
    <h3 class="text-yellow-400 font-extrabold tracking-widest text-lg">
      HYUNDAI
    </h3>

    {
      isNew && (
        <span class="inline-block mt-1 text-xs bg-red-600 text-white px-2 py-0.5 rounded">
          NEW
        </span>
      )
    }
  </div>

  <!-- FADE BOTTOM -->
  <div
    class="absolute bottom-0 left-0 right-0 h-40
           bg-gradient-to-t from-black/40 to-transparent z-[1]"
  >
  </div>

  <!-- IMAGE -->
  <img
    src={image}
    alt={name}
    class="absolute bottom-6 left-1/2 -translate-x-1/2
           w-[90%] object-contain z-[2]
           transition-all duration-500
           group-hover:scale-105 group-hover:-translate-y-2
           drop-shadow-[0_20px_30px_rgba(0,0,0,0.25)]
           [mask-image:linear-gradient(to_top,transparent,black_30%)]"
  />

  <!-- NAME -->
  <div
    class="absolute bottom-4 left-0 right-0 text-center
           text-white font-semibold text-lg z-10"
  >
    {name}
  </div>

  <!-- HOVER GLOW -->
  <div
    class="absolute inset-0 opacity-0 group-hover:opacity-100 transition bg-white/5"
  >
  </div>
</a>
