---
/*
  Hero Section – Hyundai Premium
  Background Image + Soft Parallax (CSS only)
*/
---

<section id="hero" class="relative overflow-x-clip bg-[#F6F1E7]">
  <!-- BACKGROUND IMAGE + PARALLAX -->
  <div
    class="absolute inset-0 z-0
           bg-[url('/images/hero-bg.jpg')]
           bg-cover bg-center bg-no-repeat
           md:bg-fixed"
    aria-hidden="true"
  >
  </div>

  <!-- GRADIENT OVERLAY (TEXT SAFE AREA) -->
  <div
    class="absolute inset-0 z-10
           bg-gradient-to-r
           from-[#F6F1E7]/95
           via-[#F6F1E7]/85
           to-[#F6F1E7]/40"
    aria-hidden="true"
  >
  </div>

  <!-- SOFT LIGHT RIGHT -->
  <div
    class="pointer-events-none absolute -top-40 -right-40
           w-[720px] h-[720px] rounded-full
           bg-white/60 blur-[140px]
           z-20"
  >
  </div>

  <!-- SOFT LIGHT LEFT -->
  <div
    class="pointer-events-none absolute top-1/3 -left-40
           w-[520px] h-[520px] rounded-full
           bg-white/40 blur-[120px]
           z-20"
  >
  </div>

  <!-- SUBTLE NOISE TEXTURE -->
  <div
    class="pointer-events-none absolute inset-0
           bg-[url('/images/noise.png')]
           opacity-[0.035] mix-blend-multiply
           z-20"
  >
  </div>

  <!-- CONTENT -->
  <div
    class="relative z-30
           max-w-7xl mx-auto px-6
           pt-24 pb-40
           grid grid-cols-1 md:grid-cols-2
           gap-14 items-center"
  >
    <!-- TEXT -->
    <div>
      <h1
        class="text-4xl md:text-5xl xl:text-6xl
               font-bold leading-tight
               mb-6 max-w-xl"
      >
        Dealer Resmi Hyundai Bandung.
      </h1>

      <p
        class="text-slate-700 text-lg md:text-xl
               leading-relaxed mb-10 max-w-xl"
      >
        Masih bingung pilih mobil yang cocok? Tenang, kami bantu temukan pilihan
        terbaik sesuai kebutuhan dan anggaran Anda!
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="https://wa.me/6282142964242?text=Halo%20Sales%20Hyundai%20Sevilla,%20saya%20ingin%20konsultasi%20mobil."
          target="_blank"
          class="bg-[#DCEBFA] text-[#002C5F]
                 px-7 py-3 rounded-full font-semibold
                 hover:bg-[#C7DDF6]
                 transition"
        >
          Konsultasi Gratis
        </a>

        <a
          href="/simulasi-kredit"
          class="border border-slate-900
                 px-7 py-3 rounded-full font-semibold
                 hover:bg-slate-900 hover:text-white
                 transition"
        >
          Simulasi Kredit
        </a>
      </div>
    </div>

    <!-- IMAGE -->
    <div class="relative flex justify-center md:justify-end">
      <img
        src="/images/palisade.png"
        alt="Hyundai Palisade"
        class="w-full max-w-xl
               scale-110 md:scale-125
               drop-shadow-[0_45px_90px_rgba(0,0,0,0.28)]"
        loading="eager"
      />
    </div>
  </div>

  <script is:inline>
    const slides = document.querySelectorAll(".hero-slide");
    let current = 0;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle("active", i === index);
      });
    }

    setInterval(() => {
      current = (current + 1) % slides.length;
      showSlide(current);
    }, 4200);
  </script>
</section>
