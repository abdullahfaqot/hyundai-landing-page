---
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

const cars = [
  {
    name: "Stargazer Cartenz X",
    slug: "stargazer-cartenz-x",
    image: "/images/cartenz-x.png",
    price: "Mulai 350 Jutaan",
    description:
      "Hyundai Stargazer Cartenz X hadir dengan desain tangguh dan fitur modern.",
  },
  {
    name: "Creta Alpha",
    slug: "creta-alpha",
    image: "/images/cretan.png",
    price: "Mulai 420 Jutaan",
    description:
      "Creta Alpha menawarkan performa dan kenyamanan premium.",
  },
];

/* 🔥 INI WAJIB */
export async function getStaticPaths() {
  return cars.map((car) => ({
    params: { slug: car.slug },
    props: { car },
  }));
}

/* 🔥 DATA DARI getStaticPaths */
const { car } = Astro.props;
---

<Navbar />

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <img src={car.image} alt={car.name} class="w-full h-full object-cover" />
    </div>

    <div>
      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        {car.name}
      </h1>

      <p class="text-xl text-emerald-600 font-semibold mb-6">
        {car.price}
      </p>

      <p class="text-slate-600 leading-relaxed mb-8">
        {car.description}
      </p>

      <a
        href={`https://wa.me/6281250156498?text=Halo%20saya%20tertarik%20${car.name}`}
        target="_blank"
        class="inline-flex items-center gap-2 bg-emerald-600 text-white px-6 py-3 rounded-xl hover:bg-emerald-700 transition"
      >
        Konsultasi via WhatsApp
      </a>
    </div>
  </div>
</section>

<Footer />
