---
import Layout from "../../layouts/Layout.astro";

// data mobil (samakan dengan yang kamu pakai)
const cars = [
  {
    slug: "creta",
    name: "Hyundai Creta",
    price: 350000000,
  },
  {
    slug: "stargazer",
    name: "Hyundai Stargazer",
    price: 320000000,
  },
  {
    slug: "ioniq-5",
    name: "Hyundai Ioniq 5",
    price: 750000000,
  },
];

// WAJIB untuk dynamic route
export function getStaticPaths() {
  return cars.map((car) => ({
    params: { slug: car.slug },
    props: { car },
  }));
}

// ambil data dari props
const { car } = Astro.props;
---

<Layout title={car.name}>
  <section class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">
      {car.name}
    </h1>

    <p class="text-lg text-slate-600 mb-6">
      Harga mulai dari:
      <span class="font-semibold text-slate-900">
        Rp {car.price.toLocaleString("id-ID")}
      </span>
    </p>

    <a
      href="/"
      class="inline-block bg-black text-white px-6 py-3 rounded-full hover:bg-slate-800 transition"
    >
      Kembali ke Beranda
    </a>
  </section>
</Layout>
