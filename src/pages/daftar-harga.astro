---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />

  <section
    class="pt-20 sm:pt-24 pb-16
           bg-gradient-to-br
           from-[#F7F3EA] via-[#F3ECDC] to-[#EFE6D2]"
  >
    <div class="w-full">
      <!-- TITLE -->
      <div class="px-4 md:px-6 max-w-5xl mx-auto">
        <h1
          class="relative text-2xl sm:text-3xl md:text-4xl
                 font-bold text-center
                 mb-10 md:mb-14 text-slate-800"
        >
          Promo Hyundai Ramadhan

          <span
            class="absolute left-1/2 -bottom-3 md:-bottom-4
                   w-20 md:w-28 h-[2px] md:h-[3px]
                   -translate-x-1/2
                   rounded-full
                   bg-gradient-to-r
                   from-transparent via-slate-400 to-transparent"
          ></span>
        </h1>
      </div>

      <!-- ========================= -->
      <!-- DAFTAR HARGA BARU (ATAS) -->
      <!-- ========================= -->

      <div class="w-full md:px-6 md:max-w-5xl md:mx-auto mb-12">
        <div
          class="bg-white
                 md:rounded-2xl
                 md:shadow-2xl
                 overflow-hidden
                 transition md:hover:scale-[1.02] duration-500"
        >
          <img
            src="/images/daftar-harga-2.png"
            alt="Daftar Harga Hyundai Terbaru"
            loading="lazy"
            class="w-full h-auto object-contain"
          />
        </div>
      </div>

      <!-- ========================= -->
      <!-- DAFTAR HARGA SEBELUMNYA -->
      <!-- ========================= -->

      <div class="px-4 md:px-6 max-w-5xl mx-auto">
        <h2
          class="text-xl md:text-2xl font-semibold text-center mb-6 text-slate-700"
        >
          Daftar Harga Hyundai
        </h2>
      </div>

      <div class="w-full md:px-6 md:max-w-5xl md:mx-auto">
        <div
          class="bg-white
                 md:rounded-2xl
                 md:shadow-2xl
                 overflow-hidden
                 transition md:hover:scale-[1.02] duration-500"
        >
          <img
            src="/images/daftar-harga.png"
            alt="Daftar Harga Hyundai"
            loading="lazy"
            class="w-full h-auto object-contain"
          />
        </div>
      </div>

      <!-- CTA -->
      <div class="px-4 md:px-6 text-center mt-12 md:mt-16">
        <a
          href="https://wa.me/6289657590865"
          target="_blank"
          class="inline-flex items-center justify-center
                 w-full sm:w-auto
                 bg-sky-400 text-white
                 px-6 md:px-8 py-3
                 rounded-full font-semibold
                 hover:bg-sky-500 md:hover:scale-105
                 transition shadow-lg"
        >
          Konsultasi Harga Terbaik
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
