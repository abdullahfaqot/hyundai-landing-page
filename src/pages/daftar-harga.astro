---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const cars = [
  { name: "Creta Alpha", price: "Rp 350.000.000" },
  { name: "Stargazer Cartenz X", price: "Rp 320.000.000" },
  { name: "Santa FE", price: "Rp 650.000.000" },
  { name: "Kona Electric N Line", price: "Rp 750.000.000" },
  { name: "Palisade Hybrid", price: "Rp 950.000.000" },
];
---

<Navbar />

<section
  class="px-6 py-24 bg-gradient-to-br from-[#F7F3EA] via-[#F3ECDC] to-[#EFE6D2]"
>
  <div class="max-w-4xl mx-auto">
    <h1 class="relative text-4xl font-bold text-center mb-14 text-slate-800">
      Daftar Harga Hyundai

      <!-- underline halus -->
      <span
        class="absolute left-1/2 -bottom-4
           w-28 h-[3px]
           -translate-x-1/2
           rounded-full
           bg-gradient-to-r
           from-transparent via-slate-400 to-transparent"
      ></span>
    </h1>

    <div class="flex justify-center">
      <div
        class="bg-white rounded-2xl shadow-2xl
           overflow-hidden
           transition-transform duration-500
           hover:scale-[1.02]"
      >
        <img
          src="/images/daftar-harga.png"
          alt="Daftar Harga Hyundai"
          class="w-full max-w-3xl
             object-contain"
        />
      </div>
    </div>

    <div class="text-center mt-12">
      <a
        href="https://wa.me/6282142964242"
        class="inline-flex items-center gap-2
               bg-sky-400 text-white
               px-8 py-3 rounded-full font-semibold
               hover:bg-sky-500 hover:scale-105
               transition shadow-lg"
      >
        Konsultasi Harga Terbaik
      </a>
    </div>
  </div>
</section>

<Footer />
