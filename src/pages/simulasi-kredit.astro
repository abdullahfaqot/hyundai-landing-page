---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section
    class="min-h-screen flex items-center justify-center bg-gray-100 px-4 py-20"
  >
    <div class="w-full max-w-2xl bg-white p-10 rounded-3xl shadow-xl">
      <h1 class="text-3xl font-bold text-center mb-8">
        Simulasi Kredit Hyundai
      </h1>

      <form id="formSimulasi" class="space-y-5">
        <!-- MODEL -->
        <select id="model" class="w-full border p-3 rounded-xl" required>
          <option value="">Pilih Model Mobil</option>
        </select>

        <!-- VARIANT -->
        <select
          id="variant"
          class="w-full border p-3 rounded-xl hidden"
          required
        >
          <option value="">Pilih Tipe / Varian</option>
        </select>

        <!-- DP INPUT (BUKAN DROPDOWN) -->
        <input
          type="number"
          id="dp"
          placeholder="Masukkan DP (%) minimal 15"
          min="20"
          class="w-full border p-3 rounded-xl"
          required
        />

        <!-- TENOR -->
        <select id="tenor" class="w-full border p-3 rounded-xl" required>
          <option value="">Pilih Tenor</option>
          <option value="12">1 Tahun</option>
          <option value="24">2 Tahun</option>
          <option value="36">3 Tahun</option>
          <option value="48">4 Tahun</option>
          <option value="60">5 Tahun</option>
          <option value="72">6 Tahun</option>
          <option value="84">7 Tahun</option>
        </select>

        <input
          id="nama"
          type="text"
          placeholder="Nama Anda"
          class="w-full border p-3 rounded-xl"
          required
        />

        <input
          id="hp"
          type="tel"
          placeholder="No WhatsApp (08xxxx)"
          class="w-full border p-3 rounded-xl"
          required
        />

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-full font-semibold transition"
        >
          Konsultasi Sekarang
        </button>
      </form>
    </div>
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      // ===== DATA SESUAI BROSUR =====
      const cars = {
        "The All New KONA Electric": {
          "Signature Long": 690050000,
          "Signature Standard": 652150000,
          "Prime Long": 635000000,
          "Prime Standard": 584000000,
          Style: 565750000,
        },

        "IONIQ 5": {
          "Signature Long": 926100000,
          "Signature Standard": 874400000,
          "Prime Long": 852000000,
          "Prime Standard": 809500000,
        },

        "All New PALISADE HEV": {
          "Calligraphy AWD": 1392800000,
          "Calligraphy FWD": 1305700000,
          "Signature FWD": 1132900000,
        },

        "PALISADE DIESEL 2.2 CRDi": {
          "Signature XRT": 1119600000,
          Signature: 1090700000,
        },

        "All New SANTA FE HEV": {
          "Calligraphy XRT": 933400000,
          Calligraphy: 915700000,
          Prime: 828400000,
        },

        "The New TUCSON": {
          HEV: 767600000,
          Gasoline: 653000000,
        },

        "STARGAZER Cartenz X": {
          Prime: 401700000,
          Style: 384700000,
          Trend: 371250000,
        },

        "STARGAZER Cartenz": {
          Prime: 359300000,
          "Prime Non HSS": 349300000,
          Smart: 341350000,
          "Smart Non HSS": 331350000,
          Style: 307800000,
          Trend: 287350000,
          "Trend MT": 277100000,
        },

        "The New CRETA": {
          "N Line Turbo": 522000000,
          "N Line": 474000000,
          Alpha: 456000000,
          Prime: 439500000,
          Style: 408350000,
          Trend: 362650000,
          "Trend MT": 341600000,
          "Active MT": 308800000,
        },

        "STARGAZER X": {
          Prime: 359600000,
          Style: 348750000,
        },

        STARGAZER: {
          Prime: 332900000,
          "Essential IVT": 283000000,
          "Essential MT": 271300000,
          "Active IVT": 272550000,
          "Active MT": 259200000,
        },

        "STARIA Diesel 2.2 CRDi": {
          "7 Seater": 1074400000,
          "9 Seater": 936700000,
        },
      };

      const modelSelect = document.getElementById("model");
      const variantSelect = document.getElementById("variant");
      const form = document.getElementById("formSimulasi");

      // Isi Model
      Object.keys(cars).forEach((model) => {
        const option = document.createElement("option");
        option.value = model;
        option.textContent = model;
        modelSelect.appendChild(option);
      });

      // Saat Model Dipilih
      modelSelect.addEventListener("change", function () {
        variantSelect.innerHTML =
          '<option value="">Pilih Tipe / Varian</option>';

        if (!this.value) {
          variantSelect.classList.add("hidden");
          return;
        }

        const variants = cars[this.value];

        Object.keys(variants).forEach((variant) => {
          const option = document.createElement("option");
          option.value = variants[variant]; // harga disimpan tapi tidak ditampilkan
          option.textContent = variant;
          variantSelect.appendChild(option);
        });

        variantSelect.classList.remove("hidden");
      });

      // Submit ke WhatsApp
      form.addEventListener("submit", function (e) {
        e.preventDefault();

        const model = modelSelect.value;
        const variant =
          variantSelect.options[variantSelect.selectedIndex]?.text;
        const price = Number(variantSelect.value);
        const dpPercent = Number(document.getElementById("dp").value);
        const tenor = Number(document.getElementById("tenor").value);
        const nama = document.getElementById("nama").value.trim();
        const hp = document.getElementById("hp").value.trim();

        if (
          !model ||
          !variant ||
          !price ||
          !dpPercent ||
          !tenor ||
          !nama ||
          !hp
        ) {
          alert("Lengkapi semua data dulu yaa");
          return;
        }

        if (dpPercent < 20) {
          alert("DP minimal 20%");
          return;
        }

        const message = encodeURIComponent(
          `Halo Sevilla Hyundai Pasteur,

Nama: ${nama}
No HP: ${hp}

Mobil: ${model}
Tipe: ${variant}
Harga OTR: Rp ${price.toLocaleString("id-ID")}
DP: ${dpPercent}%
Tenor: ${tenor / 12} Tahun

Mohon info simulasi kredit terbaik`,
        );

        window.open("https://wa.me/6289657590865?text=" + message, "_blank");
      });
    });
  </script>
</Layout>
