---
const cars = [
  { name: "Hyundai The New Creta", price: 350000000 },
  { name: "Hyundai Stargazer Cartenz X", price: 320000000 },
  { name: "Hyundai Ioniq 5", price: 750000000 },
  { name: "Hyundai All New Santa FE", price: 750000000 },
  { name: "Hyundai Palisade", price: 750000000 },
  { name: "Hyundai All New Palisade HEV", price: 750000000 },
  { name: "Hyundai Stargazer", price: 750000000 },
  { name: "Hyundai Kona EV", price: 750000000 },
];
---

<section
  class="min-h-screen flex items-center justify-center bg-gradient-to-br from-[#F7F3EA] via-[#F3ECDC] to-[#EFE6D2] px-4 py-20"
>
  <div
    class="w-full max-w-xl bg-white/90 backdrop-blur rounded-3xl shadow-2xl p-8"
  >
    <h1 class="text-3xl font-bold text-center mb-6 text-slate-800">
      Simulasi Kredit Hyundai
    </h1>

    <form id="simulasiForm" class="space-y-4">
      <!-- PILIH MOBIL -->
      <select
        id="car"
        class="w-full border border-slate-300 p-3 rounded-lg"
        required
      >
        <option value="">Pilih Tipe Mobil</option>
        {cars.map((car) => <option value={car.price}>{car.name}</option>)}
      </select>

      <!-- DP -->
      <input
        id="dp"
        type="number"
        min="10"
        max="90"
        placeholder="DP (%) contoh: 20"
        class="w-full border border-slate-300 p-3 rounded-lg"
        required
      />

      <!-- TENOR -->
      <select
        id="tenor"
        class="w-full border border-slate-300 p-3 rounded-lg"
        required
      >
        <option value="">Pilih Tenor</option>
        <option value="12">1 Tahun</option>
        <option value="24">2 Tahun</option>
        <option value="36">3 Tahun</option>
        <option value="48">4 Tahun</option>
        <option value="60">5 Tahun</option>
        <option value="72">6 Tahun</option>
        <option value="84">7 Tahun</option>
      </select>

      <!-- DATA USER -->
      <input
        id="nama"
        type="text"
        placeholder="Nama Anda"
        class="w-full border border-slate-300 p-3 rounded-lg"
        required
      />

      <input
        id="hp"
        type="tel"
        placeholder="No WhatsApp (contoh: 08xxxx)"
        class="w-full border border-slate-300 p-3 rounded-lg"
        required
      />

      <button
        type="submit"
        class="w-full bg-sky-400 hover:bg-sky-500 transition
         text-white py-3 rounded-full font-semibold"
      >
        Hitung & Konsultasi
      </button>
    </form>

    <p id="hasil" class="mt-6 text-center text-lg font-semibold text-slate-800">
    </p>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("simulasiForm");

  form.addEventListener("submit", function (e) {
    e.preventDefault();

    const carSelect = document.getElementById("car");
    const price = Number(carSelect.value);
    const carName = carSelect.options[carSelect.selectedIndex].text;

    const dpPercent = Number(document.getElementById("dp").value);
    const tenor = Number(document.getElementById("tenor").value);
    const nama = document.getElementById("nama").value.trim();
    const hp = document.getElementById("hp").value.trim();

    if (!price || !dpPercent || !tenor || !nama || !hp) {
      alert("Lengkapi semua data dulu ya 🙏");
      return;
    }

    if (dpPercent < 10 || dpPercent > 90) {
      alert("DP minimal 10% dan maksimal 90%");
      return;
    }

    const dp = price * (dpPercent / 100);

    const pesan = encodeURIComponent(
      `Halo Sales Hyundai Sevilla

Saya ingin konsultasi kredit mobil Hyundai dengan detail berikut:

Nama: ${nama}
No HP: ${hp}

Tipe Mobil: ${carName}
Harga Mobil: Rp ${price.toLocaleString("id-ID")}
DP: ${dpPercent}% (Rp ${dp.toLocaleString("id-ID")})
Tenor: ${tenor / 12} Tahun

Mohon info:
Estimasi angsuran,
Simulasi terbaik sesuai kebutuhan saya

Terima kasih`,
    );

    window.open("https://wa.me/6282142964242?text=" + pesan, "_blank");
  });
</script>
