<dialog
  id="imageModal"
  class="backdrop:bg-black/70 p-0 border-none"
  onclick="event.target === this && closeModal()"
>
  <!-- Close button -->
  <button
    onclick="closeModal()"
    class="fixed top-4 right-4 z-50 text-white bg-black/50 hover:bg-black rounded-full w-10 h-10 flex items-center justify-center transition"
    aria-label="Tutup"
  >
    &times;
  </button>

  <!-- Image -->
  <img
    id="modalImage"
    src=""
    alt="Preview Testimoni"
    loading="lazy"
    class="max-h-[90vh] max-w-[90vw] object-contain m-auto block transition duration-300 scale-95 opacity-0"
  />
</dialog>

<script>
  const modal = document.getElementById("imageModal");
  const modalImage = document.getElementById("modalImage");

  (window as any).openModal = (src: string) => {
    if (!modalImage) return;
    (modalImage as HTMLImageElement).src = src;
    (modal as HTMLDialogElement)?.showModal();

    // reset state
    modalImage.classList.remove("scale-100", "opacity-100");
    modalImage.classList.add("scale-95", "opacity-0");

    // animate in
    requestAnimationFrame(() => {
      modalImage.classList.remove("scale-95", "opacity-0");
      modalImage.classList.add("scale-100", "opacity-100");
    });
  };

  (window as any).closeModal = () => {
    if (!modalImage) return;
    modalImage.classList.remove("scale-100", "opacity-100");
    modalImage.classList.add("scale-95", "opacity-0");

    setTimeout(() => {
      (modal as HTMLDialogElement)?.close();
      (modalImage as HTMLImageElement).src = "";
    }, 200);
  };
</script>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const slider = document.getElementById("promoSlider");
    const dotsContainer = document.getElementById("promoDots");
    if (!slider || !dotsContainer) return;

    const slides = Array.from(slider.children);
    const total = slides.length;
    let index = 0;
    let timer;

    // DOTS
    slides.forEach((_, i) => {
      const dot = document.createElement("button");
      dot.className = "w-2.5 h-2.5 rounded-full bg-slate-300 transition";
      dot.onclick = () => goTo(i);
      dotsContainer.appendChild(dot);
    });

    const dots = Array.from(dotsContainer.children);

    function updateDots() {
      dots.forEach((d, i) => {
        d.classList.toggle("bg-slate-900", i === index);
        d.classList.toggle("bg-slate-300", i !== index);
      });
    }

    function goTo(i) {
      index = i;

      const sliderRect = slider.getBoundingClientRect();
      const slideRect = slides[i].getBoundingClientRect();

      const offset =
        slideRect.left -
        sliderRect.left +
        slider.scrollLeft -
        (sliderRect.width / 2 - slideRect.width / 2);

      slider.scrollTo({
        left: offset,
        behavior: "smooth",
      });

      updateDots();
      restart();
    }

    function next() {
      index = (index + 1) % total;
      goTo(index);
    }

    function start() {
      timer = setInterval(next, 5000); // 5 DETIK
    }

    function restart() {
      clearInterval(timer);
      start();
    }

    // Pause saat tab tidak aktif
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) clearInterval(timer);
      else start();
    });

    updateDots();
    start();
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById(
      "pdfFrame",
    ) as HTMLIFrameElement | null;
    const openBtn = document.getElementById(
      "pdfOpenNewTab",
    ) as HTMLAnchorElement | null;

    document.querySelectorAll("[data-pdf]").forEach((card) => {
      card.addEventListener("click", () => {
        const url = card.getAttribute("data-pdf");
        if (!url || !modal || !frame) return;

        frame.src = `${url}#toolbar=1&navpanes=0`;

        if (openBtn) {
          openBtn.href = url;
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });
  });

  function closePdf() {
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById(
      "pdfFrame",
    ) as HTMLIFrameElement | null;
    const openBtn = document.getElementById(
      "pdfOpenNewTab",
    ) as HTMLAnchorElement | null;

    if (modal && frame) {
      frame.src = "";
      if (openBtn) openBtn.href = "#";
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }
  }

  (window as any).closePdf = closePdf;
</script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const slider = document.getElementById("testiSlider");
    if (!slider) return;

    const slides = Array.from(slider.children);
    let index = 0;
    let intervalId = null;

    function goToSlide(i) {
      const slide = slides[i];
      if (!slide) return;

      slider.scrollTo({
        left: slide.offsetLeft - 16,
        behavior: "smooth",
      });
    }

    function nextSlide() {
      index = (index + 1) % slides.length;
      goToSlide(index);
    }

    function startAutoSlide() {
      stopAutoSlide();
      intervalId = setInterval(nextSlide, 4000);
    }

    function stopAutoSlide() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }

    slider.addEventListener("touchstart", stopAutoSlide);
    slider.addEventListener("touchend", startAutoSlide);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopAutoSlide();
      else startAutoSlide();
    });

    startAutoSlide();
  });
</script>

