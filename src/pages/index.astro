---

<head>
  <link rel="preload" as="image" href="/images/promo1.png" />
  <link rel="preload" as="image" href="/images/promo2.png" />
  <link rel="preload" as="image" href="/images/promo3.png" />
  <link rel="preload" as="image" href="/images/promo4.png" />
  <link rel="preload" as="image" href="/images/promo5.png" />
  <link rel="preload" as="image" href="/images/promo6.png" />
</head>

<Navbar />
<Hero />

<section class="px-6 py-12">
  <div
    class="grid grid-cols-1
           sm:grid-cols-2
           lg:grid-cols-4
           gap-6
           max-w-7xl mx-auto"
  >
    {
      cars.map((car) => (
        <CarCard
          name={car.name}
          slug={car.slug}
          image={car.image}
          gradient={car.gradient}
          isNew={car.isNew}
        />
      ))
    }
  </div>
</section>

<section class="px-6 py-20 bg-white text-slate-900">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
    PROSES MUDAH & CEPAT
  </h2>

  <p class="text-center max-w-3xl mx-auto text-slate-600 mb-12">
    Ingin punya mobil Hyundai impian tanpa repot? Kami bantu prosesnya jadi
    lebih mudah dan cepat. Yuk, konsultasi sekarang!
  </p>

  <div
    class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6"
  >
    {
      testimonials.map((item) => (
        <button
          class="overflow-hidden rounded-xl shadow-md hover:scale-105 transition"
          onclick={`openModal('${item.image}')`}
        >
          <img
            src={item.image}
            alt="Testimoni Hyundai"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </button>
      ))
    }
  </div>
</section>

<section class="px-6 py-20 bg-white text-slate-900">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
    Promo Hyundai Bulan Ini
  </h2>

  <p class="text-center max-w-3xl mx-auto text-slate-600 mb-12">
    Promo terbatas, hanya berlaku bulan ini. Jangan sampai terlewat!
  </p>

  <div class="relative max-w-7xl mx-auto overflow-hidden">
    <div id="promoSlider" class="flex gap-6 will-change-transform">
      {
        promos.map((promo) => (
          <div class="min-w-[70%] md:min-w-[40%] lg:min-w-[28%] shadow">
            <a
              href={`https://wa.me/628123456789?text=${encodeURIComponent(
                promo.waText,
              )}`}
              target="_blank"
              class="promo-card block rounded-xl overflow-hidden group"
            >
              <img
                src={promo.image}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              />
            </a>
          </div>
        ))
      }
    </div>

    <div id="promoDots" class="flex justify-center gap-2 mt-6"></div>
  </div>
</section>

<section class="px-6 py-20 bg-white">
  <div
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 items-stretch"
  >
    <!-- FOTO FULL -->
    <div class="rounded-2xl overflow-hidden shadow-lg">
      <img
        src="/images/testi5.png"
        alt="Dealer Hyundai Bandung"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- 4 CARD -->
    <div class="flex flex-col gap-6">
      <!-- CARD 1 -->
      <div class="bg-white rounded-xl shadow-md p-6 flex gap-4 flex-1">
        <div class="text-blue-600 flex-shrink-0">
          <!-- Rocket -->
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-xl text-slate-900 mb-1">
            Proses Mudah & Cepat
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            Kami berkomitmen memberikan layanan terbaik dengan proses kredit
            yang cepat.
          </p>
        </div>
      </div>

      <!-- CARD 2 -->
      <div class="bg-white rounded-xl shadow-md p-6 flex gap-4 flex-1">
        <div class="text-blue-600 flex-shrink-0">
          <!-- User Group -->
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M17 20h5v-2a4 4 0 00-4-4h-1"></path>
            <path d="M9 20H4v-2a4 4 0 014-4h1"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-xl text-slate-900 mb-1">
            Sales Berpengalaman
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            Hyundai Pasteur didukung sales profesional dan berpengalaman.
          </p>
        </div>
      </div>

      <!-- CARD 3 -->
      <div class="bg-white rounded-xl shadow-md p-6 flex gap-4 flex-1">
        <div class="text-blue-600 flex-shrink-0">
          <!-- Currency -->
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path d="M12 1v22"></path>
            <path d="M17 5H9.5a3.5 3.5 0 000 7H14a3.5 3.5 0 010 7H6"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-xl text-slate-900 mb-1">Harga Fleksibel</h3>
          <p class="text-slate-600 text-base leading-relaxed">
            Solusi pembelian mobil sesuai budget dan kebutuhan Anda.
          </p>
        </div>
      </div>

      <!-- CARD 4 -->
      <div class="bg-white rounded-xl shadow-md p-6 flex gap-4 flex-1">
        <div class="text-blue-600 flex-shrink-0">
          <!-- Credit Card -->
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-xl text-slate-900 mb-1">
            Harga Kredit Murah
          </h3>
          <p class="text-slate-600 text-base leading-relaxed">
            DP terjangkau dan dukungan penuh hingga proses ACC.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-20 bg-white overflow-x-hidden">
  <div class="max-w-7xl mx-auto px-6 overflow-hidden">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">
      OUR PARTNER FINANCE & LEASING
    </h2>

    <p class="text-center max-w-3xl mx-auto text-slate-600 mb-12">
      Yuk, konsultasi gratis sekarang untuk harga mobil impian Anda di Dealer
      Resmi Hyundai Bandung
    </p>

    <!-- SLIDER -->
    <div class="relative overflow-hidden">
      <div class="overflow-hidden w-full"></div>
      <div class="partner-slider flex items-center gap-10">
        {
          [...partners, ...partners].map((item) => (
            <div
              class="flex items-center justify-center
         min-w-[160px] md:min-w-[200px] flex-shrink-0
  h-24 bg-white rounded-xl shadow-sm
  overflow-hidden hover:scale-105 transition"
            >
              <img
                src={item.logo}
                alt={item.name}
                loading="lazy"
                class="h-14 w-auto mx-auto object-contain"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<dialog
  id="imageModal"
  class="backdrop:bg-black/70 p-0 border-none"
  onclick="event.target === this && closeModal()"
>
  <!-- Close button -->
  <button
    onclick="closeModal()"
    class="fixed top-4 right-4 z-50 text-white bg-black/50 hover:bg-black rounded-full w-10 h-10 flex items-center justify-center transition"
    aria-label="Tutup"
  >
    &times;
  </button>

  <!-- Image -->
  <img
    id="modalImage"
    src=""
    alt="Preview Testimoni"
    loading="lazy"
    class="max-h-[90vh] max-w-[90vw] object-contain m-auto block transition duration-300 scale-95 opacity-0"
  />
</dialog>

<script>
  const modal = document.getElementById("imageModal");
  const modalImage = document.getElementById("modalImage");

  (window as any).openModal = (src: string) => {
    if (!modalImage) return;
    (modalImage as HTMLImageElement).src = src;
    (modal as HTMLDialogElement)?.showModal();

    // reset state
    modalImage.classList.remove("scale-100", "opacity-100");
    modalImage.classList.add("scale-95", "opacity-0");

    // animate in
    requestAnimationFrame(() => {
      modalImage.classList.remove("scale-95", "opacity-0");
      modalImage.classList.add("scale-100", "opacity-100");
    });
  };

  (window as any).closeModal = () => {
    if (!modalImage) return;
    modalImage.classList.remove("scale-100", "opacity-100");
    modalImage.classList.add("scale-95", "opacity-0");

    setTimeout(() => {
      (modal as HTMLDialogElement)?.close();
      (modalImage as HTMLImageElement).src = "";
    }, 200);
  };
</script>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const slider = document.getElementById("promoSlider");
    const dotsContainer = document.getElementById("promoDots");

    if (!slider || !dotsContainer) return;

    let slides = Array.from(slider.children);
    const total = slides.length;
    const gap = 24;
    let index = 0;
    let slideSize = 0;
    let timer = null;

    // CLONE
    const first = slides[0].cloneNode(true);
    const last = slides[total - 1].cloneNode(true);

    slider.appendChild(first);
    slider.insertBefore(last, slides[0]);

    slides = Array.from(slider.children);

    function calcSize() {
      const refSlide = slides[1];
      if (!refSlide) return;

      slideSize = refSlide.getBoundingClientRect().width + gap;
      slider.style.transition = "none";
      slider.style.transform = `translateX(-${slideSize}px)`;
    }

    // WAIT IMAGE LOAD
    const images = slider.querySelectorAll("img");
    Promise.all(
      Array.from(images).map(
        (img) =>
          img.complete ||
          new Promise((resolve) => {
            img.addEventListener("load", resolve, { once: true });
            img.addEventListener("error", resolve, { once: true });
          }),
      ),
    ).then(() => {
      calcSize();
      start();
    });

    window.addEventListener("resize", calcSize);

    // DOTS
    for (let i = 0; i < total; i++) {
      const dot = document.createElement("button");
      dot.className = "w-2.5 h-2.5 rounded-full bg-slate-300 transition";
      dot.addEventListener("click", () => goTo(i));
      dotsContainer.appendChild(dot);
    }

    const dots = Array.from(dotsContainer.children);

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-slate-900", i === index);
        dot.classList.toggle("bg-slate-300", i !== index);
      });
    }

    function goTo(i) {
      index = i;
      slider.style.transition = "transform 0.5s ease";
      slider.style.transform = `translateX(-${slideSize * (i + 1)}px)`;
      updateDots();
      restart();
    }

    function next() {
      index++;
      slider.style.transition = "transform 0.5s ease";
      slider.style.transform = `translateX(-${slideSize * (index + 1)}px)`;
    }

    slider.addEventListener("transitionend", () => {
      if (index === total) {
        slider.style.transition = "none";
        index = 0;

        // RESET DI FRAME YANG SAMA (NO BLINK)
        requestAnimationFrame(() => {
          slider.style.transform = `translateX(-${slideSize}px)`;
        });
      }

      updateDots();
    });

    function start() {
      timer = setInterval(next, 3500);
    }

    function restart() {
      if (timer) clearInterval(timer);
      start();
    }

    // PAUSE SAAT TAB HIDDEN
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && timer) clearInterval(timer);
      else start();
    });

    updateDots();
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById(
      "pdfFrame",
    ) as HTMLIFrameElement | null;
    const openBtn = document.getElementById(
      "pdfOpenNewTab",
    ) as HTMLAnchorElement | null;

    document.querySelectorAll("[data-pdf]").forEach((card) => {
      card.addEventListener("click", () => {
        const url = card.getAttribute("data-pdf");
        if (!url || !modal || !frame) return;

        frame.src = `${url}#toolbar=1&navpanes=0`;

        if (openBtn) {
          openBtn.href = url;
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
      });
    });
  });

  function closePdf() {
    const modal = document.getElementById("pdfModal");
    const frame = document.getElementById(
      "pdfFrame",
    ) as HTMLIFrameElement | null;
    const openBtn = document.getElementById(
      "pdfOpenNewTab",
    ) as HTMLAnchorElement | null;

    if (modal && frame) {
      frame.src = "";
      if (openBtn) openBtn.href = "#";
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }
  }

  (window as any).closePdf = closePdf;
</script>

<PdfModal />
<Footer />
