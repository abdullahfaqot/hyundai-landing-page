---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const cars = [
  {
    name: "Creta Alpha",
    slug: "creta-alpha",
    image: "/images/cretan.png",
    gradient: "from-blue-900 via-blue-800 to-blue-700",
    isNew: true,
  },
  {
    name: "Stargazer Cartenz X",
    slug: "stargazer-cartenz-x",
    image: "/images/cartenz-x.png",
    gradient: "from-emerald-900 via-green-800 to-green-700",
    isNew: true,
  },
  {
    name: "Kona Electric N Line",
    slug: "kona-electric-n-line",
    image: "/images/konan.png",
    gradient: "from-emerald-900 via-green-800 to-green-700",
    isNew: true,
  },
  {
    name: "Santa FE",
    slug: "santafe",
    image: "/images/santafe.png",
    gradient: "from-emerald-900 via-green-800 to-green-700",
    isNew: true,
  },
  {
    name: "Palisade Hybrid",
    slug: "palisade-hybrid",
    image: "/images/palisade.png",
    gradient: "from-emerald-900 via-green-800 to-green-700",
    isNew: true,
  },
  {
    name: "Creta N Line",
    slug: "creta-n-line",
    image: "/images/cretan.png",
    gradient: "from-emerald-900 via-green-800 to-green-700",
    isNew: true,
  },
];
---

<Navbar />

<section class="w-full px-6 py-16 bg-slate-950">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold text-white text-center mb-12">
      Tipe Mobil Hyundai
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {cars.map((car) => (
        <a
          href={`/product/${car.slug}`}
          class={`group relative min-h-[420px]
          rounded-xl overflow-hidden
          bg-gradient-to-br ${car.gradient}
          shadow-[0_25px_45px_rgba(0,0,0,0.4)]
          transition-all duration-500
          hover:-translate-y-2`}
        >
          <!-- overlay -->
          <div class="absolute inset-0 bg-black/10"></div>

          <!-- text -->
          <div class="relative z-10 p-7">
            <h3 class="text-yellow-400 font-extrabold tracking-widest">
              HYUNDAI
            </h3>

            <h4 class="mt-2 text-white font-bold text-xl uppercase">
              {car.name}
            </h4>

            {car.isNew && (
              <span class="inline-block mt-2 text-xs bg-red-600 text-white px-3 py-1 rounded">
                NEW
              </span>
            )}
          </div>

          <!-- fade -->
          <div
            class="absolute bottom-0 left-0 right-0 h-52
            bg-gradient-to-t from-black/60 to-transparent z-[1]"
          ></div>

          <!-- image -->
          <img
  src={car.image}
  alt={car.name}
  class="absolute bottom-0 left-1/2 -translate-x-1/2
  w-[95%] h-[70%]
  object-contain z-[2]
  transition-all duration-500
  group-hover:scale-110 group-hover:-translate-y-6
  drop-shadow-[0_35px_45px_rgba(0,0,0,0.45)]
  [mask-image:linear-gradient(to_top,transparent,black_30%)]"
/>


          <!-- footer -->
          <div
            class="absolute bottom-6 left-0 right-0 text-center
            text-white font-semibold text-lg z-10"
          >
            {car.name}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<Footer />
