---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const cars = [
  {
    name: "Creta N Line",
    slug: "creta-n-line",
    image: "/images/cretan.png",
    isNew: true,
  },
  {
    name: "Stargazer Cartenz X",
    slug: "stargazer-cartenz-x",
    image: "/images/cartenz-x.png",
    isNew: true,
  },
  {
    name: "Stargazer Cartenz",
    slug: "stargazer-cartenz",
    image: "/images/cartenz.png",
    isNew: true,
  },
  {
    name: "Kona Electric N Line",
    slug: "kona-electric-n-line",
    image: "/images/konan.png",
    isNew: true,
  },
  {
    name: "Santa FE",
    slug: "santafe",
    image: "/images/santafe.png",
    isNew: true,
  },
  {
    name: "Palisade",
    slug: "palisade",
    image: "/images/palisade.png",
    isNew: true,
  },
  {
    name: "Ioniq 5",
    slug: "ioniq-5",
    image: "/images/ioniq5.png",
    isNew: true,
  },
  {
    name: "Palisade Hybrid",
    slug: "palisade-hybrid",
    image: "/images/palisade-hybrid.png",
    isNew: true,
  },
];

---

<Navbar />

<section class="w-full px-6 py-20 bg-[#E9DFD3]">
  <div class="max-w-7xl mx-auto">
    <h1
  class="relative text-4xl font-bold text-[#002C5F] text-center mb-16"
>
  Tipe Mobil Hyundai

  <!-- underline halus -->
  <span
    class="absolute left-1/2 -bottom-4
           w-32 h-[3px]
           -translate-x-1/2
           rounded-full
           bg-gradient-to-r
           from-transparent via-[#002C5F]/50 to-transparent"
  ></span>
</h1>


    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {cars.map((car) => (
        <div
          class="group relative min-h-[380px]
                 rounded-2xl overflow-hidden
                 bg-[#E9DFD3]
                 transition-all duration-300
                 hover:-translate-y-1 hover:shadow-2xl
                 cursor-default"
        >
          <!-- soft light -->
          <div class="absolute inset-0 bg-white/40"></div>

          <!-- text -->
          <div class="relative z-20 p-6">
            <h3 class="text-[#002C5F] font-extrabold tracking-widest text-lg">
              HYUNDAI
            </h3>

            {car.isNew && (
              <span
  class="relative inline-flex items-center
         mt-3 px-3 py-1
         text-xs font-bold tracking-wider
         text-white bg-red-600
         rounded-full overflow-hidden
         shadow-md
         animate-pulse-soft"
>
  NEW

  <!-- shine effect -->
  <span
    class="absolute inset-0
           -translate-x-full
           bg-gradient-to-r
           from-transparent via-white/60 to-transparent
           animate-shine"
  ></span>
</span>

            )}
          </div>

          <!-- image -->
          <div
            class="absolute bottom-14 left-0 right-0
                   flex justify-center items-end
                   h-[240px] z-20"
          >
            <img
              src={car.image}
              alt={car.name}
              draggable="false"
              class="w-[120%] max-w-none
                     object-contain
                     transition-transform duration-500 ease-out
                     group-hover:scale-110 group-hover:-translate-y-3
                     drop-shadow-[0_35px_45px_rgba(0,0,0,0.35)]
                     pointer-events-none"
            />
          </div>

          <!-- fade bottom -->
          <div
            class="absolute bottom-0 left-0 right-0 h-32
                   bg-gradient-to-t from-black/25 to-transparent z-10"
          ></div>

          <!-- name -->
          <div
            class="absolute bottom-5 left-0 right-0
                   text-center text-[#002C5F]
                   font-semibold text-lg z-20"
          >
            {car.name}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
@keyframes shine {
  0% {
    transform: translateX(-120%);
  }
  70% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(120%);
  }
}

@keyframes pulseSoft {
  0%, 100% {
    box-shadow: 0 0 0 rgba(220, 38, 38, 0);
  }
  50% {
    box-shadow: 0 0 16px rgba(220, 38, 38, 0.6);
  }
}

.animate-shine {
  animation: shine 3s ease-in-out infinite;
}

.animate-pulse-soft {
  animation: pulseSoft 1.6s ease-in-out infinite;
}
</style>




<Footer />
